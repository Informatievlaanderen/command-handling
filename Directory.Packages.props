<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Dapper" Version="2.1.79" />
        <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
        <PackageVersion Include="SqlStreamStore" Version="1.2.0" />
        <PackageVersion Include="SqlStreamStore.MsSql" Version="1.2.0" />

        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />

        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="NodaTime" Version="3.3.2" />
        <PackageVersion Include="CompareNETObjects" Version="4.84.0" />
        <PackageVersion Include="System.Collections.Immutable" Version="10.0.8" />

        <PackageVersion Include="Be.Vlaanderen.Basisregisters.EventHandling" Version="7.1.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.Utilities.HashCodeCalculator" Version="5.1.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.Utilities.ToStringBuilder" Version="4.1.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.Utilities.HexByteConvertor" Version="5.1.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.Converters.Timestamp" Version="4.1.0" />
        <PackageVersion Include="Be.Vlaanderen.Basisregisters.Generators.Guid.Deterministic" Version="5.1.0" />

        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />

        <PackageVersion Include="SourceLink.Embed.AllSourceFiles" Version="2.8.3" />
        <PackageVersion Include="SourceLink.Copy.PdbFiles" Version="2.8.3" />
    </ItemGroup>
</Project>
